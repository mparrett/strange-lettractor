# Configuration for one autoresearch run. Sourced by sh: KEY=value, quote spaces.
GOAL="Make the experiment's metric as good as possible"
TAG=sep17                       # branch autoresearch/$TAG must not exist yet
EDITABLE="solve.py"             # space-separated paths or globs the agent may edit
RUN_CMD="python3 bench.py"      # any command: python3, lg, make, cargo, ...
METRIC_REGEX="^score:"          # line in the output carrying the metric
DIRECTION=min                   # min (lower is better) or max
EPSILON=0                       # gains no larger than this are ties
MAX_ITERATIONS=0                # 0 = never stop (the original behaviour)
MAX_REPAIRS=2                   # crash-fix attempts per idea
