GOAL="Minimize the median seconds bench.lg reports for solve/count-primes, keeping it correct"
TAG=demo
EDITABLE="solve.lg"
# LG names the let-go runtime; it must be on PATH or set in the environment.
RUN_CMD='"${LG:-lg}" -source-paths . bench.lg'
METRIC_REGEX="^score:"
DIRECTION=min
EPSILON=0.002
MAX_ITERATIONS=3
MAX_REPAIRS=1
