(defn make-wait-human-handler [interviewer]
  (fn [node ctx graph _logs-root]
    (let [outgoing (filter (fn [e] (= (:from e) (:id node))) (:edges graph))
          choices (map (fn [e]
                         (let [label (if (str/blank? (:label e)) (:to e) (:label e))
                               key (interviewer/parse-accelerator-key label)]
                           {:key key :label label :to (:to e)}))
                       outgoing)]
      (if (empty? choices)
        {:status :fail :failure_reason "No outgoing edges for human gate"}
        (let [opts (map (fn [c] {:key (:key c) :label (:label c)}) choices)
              ;; human.timeout_seconds is a project extension: the question record
              ;; defines the field, but the upstream engine never populates it
              ;; for wait.human nodes.
              timeout-seconds (let [raw (get-in node [:attrs :human.timeout_seconds])]
                                (when-not (str/blank? (str raw))
                                  (try (Double/parseDouble (str raw)) (catch Object _ nil))))
              question (cond-> {:text (or (:label node) "Select an option:")
                                :type :multiple_choice
                                :options opts
                                :stage (:id node)}
                         timeout-seconds (assoc :timeout_seconds timeout-seconds))
              emit (or (:emit-event node) (fn [_] nil))
              asked-at (System/currentTimeMillis)
              _ (emit {:type :interview.started :question question :stage (:id node)})
              answer (interviewer/ask interviewer question)
              duration (- (System/currentTimeMillis) asked-at)
              _ (if (= (:value answer) :timeout)
                  (emit {:type :interview.timeout :question question :stage (:id node) :duration_ms duration})
                  (emit {:type :interview.completed :question question :answer answer :stage (:id node) :duration_ms duration}))]

          (cond
            (= (:value answer) :timeout)
            (let [def-choice (get-in node [:attrs :human.default_choice])]
              (if def-choice
                (let [matched (or (first (filter (fn [c] (= (:to c) def-choice)) choices))
                                  (first choices))]
                  {:status :success
                   :suggested_next_ids [(:to matched)]
                   :preferred_label (:label matched)
                   :context_updates {"human.gate.selected" (:key matched)
                                     "human.gate.label" (:label matched)}})
                {:status :retry :failure_reason "human gate timeout, no default"}))

            (= (:value answer) :skipped)
            {:status :fail :failure_reason "human skipped interaction"}

            :else
            (let [ans-val (str (:value answer))
                  ans-text (str (:text answer))
                  matched (or (first (filter (fn [c] (or (= (str/lower-case (:key c)) (str/lower-case ans-val))
                                                         (= (str/lower-case (:label c)) (str/lower-case ans-val))
                                                         (= (str/lower-case (:label c)) (str/lower-case ans-text))))
                                             choices))
                              (first choices))]
              {:status :success
               :suggested_next_ids [(:to matched)]
               :preferred_label (:label matched)
               :context_updates {"human.gate.selected" (:key matched)
                                 "human.gate.label" (:label matched)}})))))))