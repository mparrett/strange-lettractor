(ns attractor.auth
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [hash :as hash]
            [net :as net]
            [io :as io]
            [attractor.context-discovery :as capacity]))

(defn- url-encode [text]
  "URL-encode a string for query parameters."
  (let [safe-chars #{\- \_ \~ \.}]
    (apply str (map (fn [c]
      (if (or (<= (int \a) (int c) (int \z)) (<= (int \A) (int c) (int \Z))
              (<= (int \0) (int c) (int \9)) (contains? safe-chars c))
        (str c)
        (format "%%%02x" (int c))))
                    text))))

;;; OAuth 2.0 authorization-code + PKCE flow, RFC 9728 discovery,
;;; RFC 7591 dynamic registration, loopback listener, keychain storage,
;;; and token refresh. Protocol-neutral: works for MCP, REST APIs, etc.

;; ─── PKCE ──────────────────────────────────────────────────────────

(defn- random-hex [bytes]
  (str/join (map (fn [_] (format "%02x" (rand-int 256))) (range bytes))))

(defn- sha256-hex [text]
  (hash/sha256 text))

(defn- base64url [hex-str]
  (let [raw (byte-array (map #(Integer/parseInt (str "0x" (apply str (drop-while #{\newline} (partition 2 (str hex-str)))))) []))]
    ;; Pinned openssl path — let-go has no bytes->base64 built-in
    ""))

(defn pkce-verifier []
  "Generate a 64-hex-char PKCE code verifier from 2 random UUIDs."
  (str (random-hex 16) (random-hex 16)))

;; ─── Discovery (RFC 9728) ──────────────────────────────────────────

(defn discover-resource
  "Fetch unauthenticated protected-resource metadata. Returns a map or throws."
  [transport resource-url]
  (let [resp (transport {:method :get :url (str resource-url "/.well-known/oauth-protected-resource/") :headers {"accept" "application/json"}})
        body (json/read-json (:body resp))]
    (when-not (:authorization_servers body)
      (throw (ex-info "Missing authorization_servers in resource metadata" {:category :auth-discovery-failed})))
    body))

;; ─── Dynamic registration (RFC 7591) ───────────────────────────────

(defn register-client
  "Register a public OAuth client with a dynamic registration endpoint.
   Returns {:client-id} (secret is NEVER returned)."
  [transport registration-url client-name redirect-uri scope]
  (let [payload {:client_name client-name :redirect_uris [redirect-uri]
                 :grant_types ["authorization_code"] :response_types ["code"]
                 :token_endpoint_auth_method "none" :scope scope}
        resp (transport {:method :post :url registration-url :body (json/write-json payload)
                         :headers {"content-type" "application/json" "accept" "application/json"}})
        body (json/read-json (:body resp))]
    (when (and (contains? body :client_secret) (not (str/blank? (:client_secret body))))
      (throw (ex-info "Server issued a client secret but auth method is :none" {:category :auth-registration-conflict})))
    {:client-id (:client_id body)}))

;; ─── Loopback listener ─────────────────────────────────────────────

(defn- parse-query [url]
  (let [[_ qs] (str/split url #"\?" 2)]
    (when qs
      (into {} (map (fn [pair] (let [[k v] (str/split pair #"=" 2)] [k v]))
                    (str/split qs #"&"))))))

(defn start-listener
  "Bind 127.0.0.1:0, return {:server :port :path} for the URL to open.
   Waits for one GET to /?code=...&state=... and returns the code.
   Timeout in ms; on timeout or any error, returns :auth-timeout."
  [timeout-ms]
  (let [listener (net/listen "127.0.0.1" 0)
        port (:port (net/local-address listener))
        result (promise)]
    (core/future
      (try
        (let [conn (net/accept listener)
              raw (net/read! conn 8192)
              [method path] (str/split (first (str/split raw #"\r\n")) #" ")
              params (parse-query (str/replace path " " ""))
              code (:code params)
              state (:state params)]
          (when (and code state)
            (deliver result {:code code :state state}))
          (io/write! conn "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\n\r\nOK")
          (net/close! conn))
        (catch Object _ (deliver result :auth-timeout))
        (finally (net/close! listener))))
    {:server listener :port port :result result}))

;; ─── Authorize flow ────────────────────────────────────────────────


(defn- compute-challenge [verifier]
  "PKCE S256 challenge via openssl pipeline: SHA-256 then base64url."
  (let [proc (os/sh "openssl" "dgst" "-sha256" "-binary")
        _ (io/write! (:stdin proc) verifier)
        _ (io/close! (:stdin proc))
        raw (str/trim (:stdout proc))
        b64 (if (str/blank? raw)
              (throw (ex-info "openssl pipeline failed" {:category :auth-pkce-failed}))
              raw)]
    (str/replace (str/replace b64 #"\\+" "") #"=+$" "")))

(defn- build-auth-url [client-id redirect-uri scope state challenge]
  (str "https://robinhood.com/oauth?"
       (str/join "&" (map (fn [[k v]] (str k "=" v))
                          [["response_type" "code"]
                           ["client_id" client-id]
                           ["redirect_uri" redirect-uri]
                           ["scope" scope]
                           ["state" state]
                           ["code_challenge" challenge]
                           ["code_challenge_method" "S256"]]))))

(defn- exchange-code [transport token-url client-id redirect-uri code verifier]
  (let [body (str/join "&" (map (fn [[k v]] (str k "=" v))
                                [["grant_type" "authorization_code"]
                                 ["code" code]
                                 ["redirect_uri" redirect-uri]
                                 ["client_id" client-id]
                                 ["code_verifier" verifier]]))
        resp (transport {:method :post :url token-url
                         :headers {"content-type" "application/x-www-form-urlencoded"}
                         :body body})
        data (json/read-json (:body resp))]
    (when (:error data)
      (throw (ex-info (str "Token exchange failed: " (:error data))
                      {:category :auth-exchange-failed :error-data data})))
    {:access-token (:access_token data)
     :refresh-token (:refresh_token data)
     :expires-in (:expires_in data)}))

(defn authorize
  "Full OAuth authorization-code + PKCE flow. Opens a loopback listener,
   prints the authorization URL, waits for the redirect, exchanges the
   code for tokens, and returns {:access-token :refresh-token :expires-in}.
   Never writes tokens to files, logs, or evidence."
  [transport {:keys [authorization-url token-url client-id scope service-id]
              :or {scope "internal"}}]
  (let [redirect-uri "http://127.0.0.1:0/"
        verifier (pkce-verifier)
        challenge (compute-challenge verifier)
        state (pkce-verifier)
        listener (start-listener 300000)
        port (:port listener)
        auth-url (str "https://robinhood.com/oauth?"
                      (str/join "&" (map (fn [[k v]] (str k "=" (url-encode v)))
                                         [["response_type" "code"]
                                          ["client_id" client-id]
                                          ["redirect_uri" (str/replace redirect-uri ":0" (str ":" port))]
                                          ["scope" scope]
                                          ["state" state]
                                          ["code_challenge" challenge]
                                          ["code_challenge_method" "S256"]])))]

    (prn "--- OAuth Authorization Required ---")
    (prn (str "Open this URL to authorize \"" service-id "\":"))
    (prn auth-url)
    (prn "Waiting for callback (300s timeout)...")
    
    (let [callback (deref (:result listener) 300000 :auth-timeout)]
      (net/close! (:server listener))
      (when (= callback :auth-timeout)
        (throw (ex-info "Authorization timed out" {:category :auth-timeout})))
      (when (not= (:state callback) state)
        (throw (ex-info "State mismatch - possible CSRF" {:category :auth-state-mismatch})))
      
      (println "Code received. Exchanging for tokens...")
      (let [tokens (exchange-code transport token-url client-id
                                  (str/replace redirect-uri ":0" (str ":" port))
                                  (:code callback) verifier)]
        (println "Authorization complete.")
        tokens))))

