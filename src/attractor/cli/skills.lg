(ns attractor.cli.skills
  (:require [attractor.cli :as cli]))

    (println (str "Querying models from " provider " (" (llm/resolve-base-url provider base-url) ")..."))
    (let [models (llm/fetch-models provider {:base_url base-url :api_key api-key})]
      (if (seq models)
        (do
          (println (str "Found " (count models) " available model(s):"))
          (doseq [m (sort models)]
            (println (str "  • " provider "/" m))))
        (println "No models found or request failed. Check your API key and base URL."))
      0)
    (catch Object error
      (if (= :configuration (:category (ex-data error)))
        (do (println (str "Error: " (ex-message error))) 1)
        (throw error)))))

(defn cmd-models
  "models [--provider <id>] [--base-url <u>] [--api-key <k>]: list models from
   one provider, or from every provider that can be queried when no provider
   is named."
  [args]
  (let [known #{"--provider" "--base-url" "--api-key" "--env-file"}
        unknown (filter #(and (str/starts-with? % "--") (not (contains? known %))) args)]
    (when (seq unknown)
      (println (str "Error: unknown option " (first unknown) "; expected one of " (str/join ", " (sort known))))
      (os/exit 2))
    (let [provider (find-arg-val args "--provider")
          base-url (find-arg-val args "--base-url")
          api-key (find-arg-val args "--api-key")]
      (if provider
        (os/exit (list-models! provider base-url api-key))
        (let [ids (queryable-providers)]
          (when (empty? ids)
            (println "No provider can be queried: add a key in attractor.edn or the environment, or pass --provider with --api-key.")
            (os/exit 1))
          (when (or base-url api-key)
            (println "Error: --base-url and --api-key apply to one provider; pass --provider as well.")
            (os/exit 2))
          (let [codes (mapv (fn [id] (let [code (list-models! id nil nil)] (println) code)) ids)]
            (os/exit (if (every? zero? codes) 0 1))))))))

;; CLI Entry Point
(defn -main [& args]
  (let [raw (or (seq args) (seq *command-line-args*) [])
        clean-args (if (= (first raw) "--") (vec (rest raw)) (vec raw))
        env-path (find-arg-val clean-args "--env-file")
        _ (dotenv/load-dotenv! env-path)
        cmd (first clean-args)
        rest-args (vec (rest clean-args))]
    (case cmd
      "run" (cmd-run rest-args)
      "validate" (cmd-validate rest-args)
      "lint" (cmd-validate rest-args)
      "graph" (cmd-graph rest-args)
      "resume" (cmd-resume rest-args)
      "serve" (cmd-serve rest-args)
      "hub" (cmd-hub rest-args)
      "clean" (cmd-clean rest-args)
      "cleanup" (cmd-clean rest-args)
      "models" (cmd-models rest-args)
      "providers" (cmd-providers rest-args)
      "mcp" (cmd-mcp rest-args)
      "skills" (cmd-skills rest-args)
      "agent" (cmd-agent rest-args)
      "console" (cmd-console rest-args)
      "help" (print-usage)
      nil (print-usage)
      (do
        (println (str "Unknown command: " cmd))
        (print-usage)
        (os/exit 1)))))
