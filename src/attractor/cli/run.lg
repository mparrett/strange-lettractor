(ns attractor.cli.run
  (:require [attractor.cli :as cli]))

    (println "Cleanup complete.")
    (os/exit 0)))

(defn- cli-skills-project-root []
  (let [top (try
              (let [result (os/sh "/bin/bash" "-c" "git rev-parse --show-toplevel")]
                (when (= 0 (:exit result))
                  (let [trimmed (str/trim (or (:out result) ""))]
                    (when-not (str/blank? trimmed) trimmed))))
              (catch Object _ nil))]
    (skills/project-skills-root top (os/cwd))))

(defn- cli-skills-access []
  (skills/local-file-access))

(defn- cmd-skills-list [roots access]
  (let [discovered (skills/discover roots)]
    (println "Skills (project root, then user root):")
    (println (str "  project: " (:project-root roots)))
    (println (str "  user:    " (or (:user-root roots) "(no home configured)")))
    (println (skills/format-roster-table discovered))
    (os/exit 0)))

(defn- cmd-skills-approvals [access]
  (let [path (skills/default-approvals-path)
        approvals (skills/read-approvals
                    (:read-text access) (:file-exists access) path)]
    (println (str "Skill approvals (" (or path "(no home configured)") "):"))
    (if (empty? approvals)
      (println "  (none)")
      (doseq [[id approval] (sort-by first approvals)]
        (println (str "  " id " -> " (:winning-root approval)))
        (println (str "    project: " (:project-digest approval)))
        (println (str "    user:    " (:user-digest approval)))))
    (os/exit 0)))

(defn- cmd-skills-approve [args access]
  (let [id (second args)
        winner (find-arg-val args "--winner")
        path (skills/default-approvals-path)]
    (when (str/blank? (or id ""))
      (do (println "Usage: attractor skills approve <skill-id> --winner project|user")
          (os/exit 1)))
    (when (nil? path)
      (do (println "Cannot approve: no home directory is configured.")
          (os/exit 1)))
    (let [roots {:project-root (cli-skills-project-root)
                 :user-root (skills/user-skills-root)}
          entry (try
                  (skills/propose-approval
                    (assoc roots
                           :read-text (:read-text access)