(defn print-usage []
  (println "Attractor - Workflow Orchestration Engine for Multi-Stage LLM Pipelines")
  (println "")
  (println "Usage: attractor <command> [options] [args]")
  (println "")
  (println "Commands:")
  (println "  run <dotfile> [--logs-root <dir>] [--auto-approve]   Execute a DOT pipeline")
  (println "  validate <dotfile>                                  Validate pipeline structure & syntax")
  (println "  graph <dotfile>                                     Inspect graph nodes, edges, and flow")
  (println "  resume [dotfile] --checkpoint <path>                Resume pipeline from checkpoint")
  (println "  serve [--port <address>] [--nrepl-port PORT | --connect PORT]  Shared HTTP/nREPL server")
  (println "  hub [--port PORT] [--port-file PATH] [--mock|--llm]  Start a persistent loopback nREPL hub")
  (println "  hub --stop PORT                                    Request graceful hub shutdown")
  (println "  models [--provider <id>] [--base-url <u>]            List models from one provider, or every queryable provider")
  (println "  providers                                           Show the effective provider registry (attractor.edn)")
  (println "  skills [approvals|approve <id> --winner r|revoke <id>]  List skills; review, approve, or revoke approvals")
  (println "  mcp [servers|authorize <id>|register <id>]         List MCP servers; authorize or register")
  (println (str "  agent <" (str/join "|" (registry/agent-names)) "> --prompt-file <file>          Run one external agent job, EDN events"))
  (println "    [--cwd <dir>] [--model <m>] [--timeout-ms <ms>] [--tools Read,Edit] [--permission-mode plan|acceptEdits|dontAsk]")
  (println "    [--sandbox read-only|workspace-write|danger-full-access] [--approval-policy never|on-request|untrusted]")
  (println "    DOT run/resume accept --agent <name> with the same options")
  (println "    Native task-review models and budgets are selected by the DOT model_stylesheet")
  (println "  console [--connect PORT] [--tui] [--mock|--llm] [--model <provider/name>] [--alias name=expansion]")
  (println "                                                      Interactive console: chat, : eval, /run, /agent <name>")
  (println "  clean [--all]                                       Clean execution artifacts, logs, and checkpoints")
  (println "  help                                                Show this help message")
  (println ""))

(defn format-validation-diagnostic [diagnostic]
  (let [prefix (case (:severity diagnostic)
                 :error "[ERROR]"
                 :warning "[WARN]"
                 :info "[INFO]")
        target (or (:node_id diagnostic)
                   (when (:edge diagnostic)
                     (str/join " -> " (:edge diagnostic)))
                   "")]
    (str "  " prefix " [" (:rule diagnostic) "] "
         (when (seq target) (str target ": "))
         (:message diagnostic))))

(defn cmd-validate [args]
  (let [dot-file (first args)]
    (if (str/blank? dot-file)
      (do
        (println "Error: Please provide a DOT file to validate.")
        (print-usage)
        (os/exit 1))
      (if-not (os/stat dot-file)
        (do
          (println (str "Error: File '" dot-file "' does not exist."))
          (os/exit 1))
        (try
          (let [dot-content (io/slurp dot-file)
                prepared (pipeline/prepare dot-content {:source-path dot-file})
                graph (:graph prepared)
                diags (:diagnostics prepared)]
            (if (empty? diags)
              (do
                (println (str "✓ Pipeline '" (:id graph) "' is valid (0 errors, 0 warnings)."))
                (println (str "  Nodes: " (count (:nodes graph)) ", Edges: " (count (:edges graph)))))
              (let [errors (filter (fn [d] (= (:severity d) :error)) diags)
                    warnings (filter (fn [d] (= (:severity d) :warning)) diags)]
                (println (str "Validation results for '" (:id graph) "': "