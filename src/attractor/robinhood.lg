(ns attractor.robinhood
  "Robinhood trading screener for underpriced options.

   Filters for:
   - Expiry range: 90-400 days
   - Budget constraint: max $500 per contract (at ask price)
   - Liquidity: 10% spread, 100+ open interest, non-zero bid

   Scores by:
   - Implied volatility
   - Liquidity metrics (spread + open interest)
   - Strike distance from underlying price

   Outputs ranked table of call opportunities."
  (:require [clojure.string :as str]
            [clojure.core :as core]
            [json :as json]
            [attractor.mcp-client :as mcp-client]))

;; Configuration constants
(def min-expiry-days 90)
(def max-expiry-days 400)
(def max-budget-cents 50000)  ; $500.00 in cents
(def max-spread-pct 10.0)     ; 10% spread
(def min-open-interest 100)

;; ============================================================================
;; Filtering Functions
;; ============================================================================

(defn- passes-expiry-filter? [option]
  "Check if option meets expiry range requirements (90-400 days)"
  (let [dte (get option "days_to_expiration")]
    (and dte (>= dte min-expiry-days) (<= dte max-expiry-days))))

(defn- passes-budget-filter? [option]
  "Check if option ask price is <= $500"
  (let [ask-price (get option "ask_price")
        ask-cents (when ask-price (long (* ask-price 100)))]
    (and ask-cents (<= ask-cents max-budget-cents))))

(defn- passes-liquidity-filter? [option]
  "Check liquidity: 10% spread, 100+ OI, non-zero bid"
  (let [bid (get option "bid_price")
        ask (get option "ask_price")
        oi (get option "open_interest")
        mid (/ (+ bid ask) 2.0)
        spread-pct (when (pos? mid) (* 100.0 (/ (- ask bid) mid)))]
    (and
      bid (> bid 0)
      ask (> ask 0)
      oi (>= oi min-open-interest)
      spread-pct (<= spread-pct max-spread-pct))))

(defn- passes-all-filters? [option]
  "Check if option passes all hard filters"
  (and (passes-expiry-filter? option)
       (passes-budget-filter? option)
       (passes-liquidity-filter? option)))

;; ============================================================================
;; Scoring Functions
;; ============================================================================

(defn- spread-pct [option]
  "Calculate bid-ask spread as percentage of midpoint"
  (let [bid (get option "bid_price")
        ask (get option "ask_price")]
    (when (and bid ask (pos? (+ bid ask)))
      (* 100.0 (/ (- ask bid) (+ bid ask))))))

(defn- abs-val [x]
  "Absolute value"
  (if (neg? x) (- x) x))

(defn- implied-vol-score [option]
  "Score based on implied volatility (lower = better). 0-1 scale"
  (let [iv (get option "implied_volatility")]
    (when iv
      (min 1.0 (max 0.0 (/ (- 2.0 iv) 2.0))))))

(defn- liquidity-score [option]
  "Score based on liquidity: spread and OI. 0-1 scale"
  (let [spread (spread-pct option)
        oi (get option "open_interest")]
    (when (and spread oi)
      (let [spread-score (max 0.0 (- 1.0 (/ spread 10.0)))
            oi-score (min 1.0 (/ (- oi 100.0) 900.0))]
        (/ (+ spread-score oi-score) 2.0)))))

(defn- strike-distance-score [option underlying-price]
  "Score based on strike distance from ATM. 0-1 scale"
  (let [strike (get option "strike_price")
        distance-pct (when (and strike underlying-price (pos? underlying-price))
                       (/ (abs-val (- strike underlying-price)) underlying-price))]
    (when distance-pct
      (cond
        (<= distance-pct 0.05) 1.0
        (<= distance-pct 0.10) 0.9
        (<= distance-pct 0.20) 0.7
        (<= distance-pct 0.30) 0.4
        :else 0.2))))

(defn- calculate-overall-score [option underlying-price]
  "Calculate composite score for option (0-100)"
  (let [iv-score (implied-vol-score option)
        liq-score (liquidity-score option)
        dist-score (strike-distance-score option underlying-price)]
    (when (and iv-score liq-score dist-score)
      (* 100.0 (/ (+ iv-score liq-score dist-score) 3.0)))))

;; ============================================================================
;; Results Formatting
;; ============================================================================

(defn- format-result [option underlying-price]
  "Format option for display"
  (let [strike (get option "strike_price")
        expiry (get option "expiration_date")
        dte (get option "days_to_expiration")
        bid (get option "bid_price")
        ask (get option "ask_price")
        iv (get option "implied_volatility")
        delta (get option "delta")
        oi (get option "open_interest")
        spread (spread-pct option)
        score (calculate-overall-score option underlying-price)
        cost-cents (long (* ask 100))
        break-even (when ask (+ strike ask))]
    {:symbol (get option "symbol")
     :strike strike
     :expiry expiry
     :dte dte
     :bid bid
     :ask ask
     :spread-pct spread
     :iv iv
     :delta delta
     :oi oi
     :cost-cents cost-cents
     :break-even break-even
     :score score}))

(defn- print-results-table [results]
  "Print results as formatted table"
  (when (empty? results)
    (println "No suitable call options found matching criteria.\n"))
  (when (seq results)
    (println "\n=== Robinhood Options Call Screener ===")
    (println (str "Found " (count results) " options matching criteria\n"))
    (println "Strike  Expiry       DTE   Bid    Ask    Spread  IV      Delta    OI    Score")
    (println (str/join (repeat 75 "-")))
    (doseq [r (take 20 results)]
      (println (str
                (r :strike) "      "
                (r :expiry) "  "
                (r :dte) "    "
                (r :bid) "  "
                (r :ask) "  "
                (r :spread-pct) "  "
                (* 100.0 (r :iv)) "  "
                (r :delta) "  "
                (r :oi) "    "
                (r :score))))
    (println "\nTop 20 shown. Filters: DTE " min-expiry-days "-" max-expiry-days
             " days, Ask <= $" (/ max-budget-cents 100.0) ", Spread <= " max-spread-pct "%")))

;; ============================================================================
;; Main Screener
;; ============================================================================

(defn screen-calls
  "Screen for underpriced call options.

   Args:
   - symbol: stock symbol (e.g., \"QQQ\", \"SPXW\")
   - mcp-handle: open MCP session handle

   Returns: list of results, sorted by score descending"
  [symbol mcp-handle]

  (let [;; Get current underlying price
        price-result (mcp-client/session-request!
                       mcp-handle "tools/call"
                       {:name "get_equity_quotes"
                        :arguments {"symbols" [symbol]}})
        quote (first (get-in price-result ["result" "data" symbol "quote"]))
        underlying-price (get quote "last_price")

        ;; Get all option chains for symbol
        chains-result (mcp-client/session-request!
                        mcp-handle "tools/call"
                        {:name "get_option_chains"
                         :arguments {"symbol" symbol}})
        chains (get-in chains-result ["result" "data"])

        ;; Get all instruments and quotes
        instrument-ids (map #(get % "id") chains)
        quotes-result (mcp-client/session-request!
                        mcp-handle "tools/call"
                        {:name "get_option_quotes"
                         :arguments {"option_ids" instrument-ids}})
        quote-data (get-in quotes-result ["result" "data"])

        ;; Merge chains with quotes and filter
        merged (for [chain chains]
                 (assoc chain
                   :quote (get quote-data (get chain "id"))))

        ;; Filter: calls only, pass all filters
        filtered (filter #(and (= (get % "type") "call")
                               (passes-all-filters? %))
                         merged)

        ;; Score and format
        formatted (map #(format-result % underlying-price) filtered)

        ;; Sort by score descending
        sorted (sort-by #(- (% :score)) formatted)]

    (print-results-table sorted)
    sorted))
