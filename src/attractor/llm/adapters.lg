(ns attractor.llm.adapters
  (:require [attractor.llm :as llm]))

(defn openai-compatible-complete [request & [api-key base-url]]
  (let [{:keys [provider url headers payload]}
        (openai-compatible-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers
                  :body (json/write-json payload)}))
        status (:status resp)
        body-str (str (:body resp))]
    (if (and (number? status) (not= status 200))
      (raise-provider-error! provider resp)
      (let [body (parse-response-body provider body-str)
            choice (first (get body "choices"))
            message (or (get choice "message") {})
            text (if (string? (get message "content"))
                   (or (get message "content") "")
                   (str/join ""
                             (map (fn [part]
                                    (if (= (get part "type") "text")
                                      (or (get part "text") "") ""))
                                  (or (get message "content") []))))
            text-parts (normalize-openai-compatible-content (get message "content"))
            tool-calls (normalize-openai-tool-calls (get message "tool_calls"))
            parts (vec (concat text-parts
                               (map (fn [call]
                                      {:kind :tool_call :tool_call call})
                                    tool-calls)))
            usage (or (get body "usage") {})]
        {:id (get body "id")
         :model (or (get body "model") (:model request))
         :provider provider
         :message {:role :assistant :content parts :parts parts :text text}
         :tool_calls tool-calls
         :reasoning (when (string? (get message "reasoning_content"))
                      (get message "reasoning_content"))
         :usage (openai-compatible-usage usage)
         :finish_reason (finish-reason (get choice "finish_reason"))
         :warnings (adapter-warnings "openai-compatible" request)
         :raw body}))))

(defn- openai-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "OPENAI_API_KEY")
        effort (portable-reasoning-effort request)
        url (resolve-openai-url (or base-url (:base_url request)))
        messages (or (:messages request) [])
        instructions (str/join "\n\n"
                               (map message-text
                                    (filter (fn [m]
                                              (or (= (:role m) :system)
                                                  (= (:role m) :developer)))
                                            messages)))
        ;; strict is the tool definition's own flag (default false): OpenAI's
        ;; strict mode rejects schemas whose optional properties are not all
        ;; listed as required, which is how profile tools are declared.
        openai-tools (mapv (fn [tool]
                             {:type "function"
                              :name (:name tool)
                              :description (:description tool)
                              :parameters (:parameters tool)
                              :strict (boolean (:strict tool))})
                           (or (:tools request) []))
        tool-choice (openai-tool-choice request)
        payload (merge
                  (cond-> {:model (:model request)
                           :input (openai-input-items messages)
                           :store false}
                    (not (str/blank? instructions)) (assoc :instructions instructions)
                    (seq openai-tools) (assoc :tools openai-tools)
                    (some? tool-choice) (assoc :tool_choice tool-choice)
                    (some? (:temperature request))
                    (assoc :temperature (:temperature request))
                    (some? (:top_p request))
                    (assoc :top_p (:top_p request))
                    (some? (:max_tokens request))
                    (assoc :max_output_tokens (:max_tokens request))
                    (some? (:metadata request))
                    (assoc :metadata (:metadata request))
                    (some? effort)
                    (assoc :reasoning {:effort effort}))
                  (openai-format request)
                  (provider-options request "openai"))
        headers (request-headers request key :openai-responses {"Content-Type" "application/json"})]
    (require-api-key! (or (:provider request) "openai") key :openai-responses)
    {:url url :headers headers :payload payload}))

(defn- normalize-openai-response [request body]
  (let [output (or (get body "output") [])
        call-items (filter (fn [item] (= (get item "type") "function_call"))
                           output)
        tool-calls (normalize-openai-tool-calls call-items)
        usage (or (get body "usage") {})
        input-details (or (get usage "input_tokens_details") {})
        output-details (or (get usage "output_tokens_details") {})
        parts (normalize-openai-parts output)]
    {:id (get body "id")
     :model (or (get body "model") (:model request))
     :provider "openai"
     :message {:role :assistant :content parts :parts parts
               :text (openai-output-text output)}
     :tool_calls tool-calls
     :usage {:input_tokens (or (get usage "input_tokens") 0)
             :output_tokens (or (get usage "output_tokens") 0)
             :reasoning_tokens (or (get output-details "reasoning_tokens") 0)
             :cache_read_tokens (or (get input-details "cached_tokens") 0)
             :total_tokens (or (get usage "total_tokens") 0)}
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (if (= (get body "status") "completed") :stop :length))
     :warnings (adapter-warnings "openai" request)
     :raw body}))

(defn openai-complete [request & [api-key base-url]]

(defn openai-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]} (openai-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers
                  :body (json/write-json (json-safe payload))}))
        status (:status resp)
        body-str (str (:body resp))]
    (if (and (number? status) (not= status 200))
      (raise-provider-error! "openai" resp)
      (normalize-openai-response request (parse-response-body "openai" body-str)))))

;; Anthropic Adapter
(defn- anthropic-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "ANTHROPIC_API_KEY")
        model-info (models/get-model-info (:model request))
        adaptive? (= :adaptive (:reasoning_mode model-info))
        effort (portable-reasoning-effort request)
        url (resolve-anthropic-url (or base-url (:base_url request)))
        system-messages (filter (fn [m]
                                  (or (= (:role m) :system)
                                      (= (:role m) :developer)))
                                (:messages request))
        schema-prompt (schema-instruction request)
        system-text (str/join "\n\n"
                              (filter (fn [text] (not (str/blank? (str text))))
                                      (concat (map message-text system-messages)
                                              [schema-prompt])))
        non-system (remove (fn [m]
                             (or (= (:role m) :system)
                                 (= (:role m) :developer)))
                           (:messages request))
        raw-msgs (merge-anthropic-messages (map anthropic-message non-system))
        raw-tools (if (= "none" (tool-choice-mode request))
                    []
                    (mapv (fn [tool]
                          {:name (:name tool)
                           :description (:description tool)
                           :input_schema (:parameters tool)})
                          (or (:tools request) [])))
        tool-choice (anthropic-tool-choice request)
        options (provider-options request "anthropic")
        beta-headers (or (:beta_headers options) (get options "beta_headers") [])
        auto-cache-setting (if (contains? options :auto_cache)
                             (:auto_cache options)
                             (if (contains? options "auto_cache")
                               (get options "auto_cache")
                               true))
        auto-cache? (not (= false auto-cache-setting))
        body-options (dissoc
                       (dissoc
                         (dissoc
                           (dissoc options :beta_headers)
                           "beta_headers")
                         :auto_cache)
                       "auto_cache")
        explicit-thinking (field body-options :thinking)
        thinking-budget (case effort
                          "low" 1024
                          "medium" 2048
                          "high" 3072
                          nil)
        max-tokens (or (:max_tokens request) 4096)
        portable-thinking
        (when (and (some? thinking-budget) (nil? explicit-thinking))
          (if adaptive? {:type "adaptive"}
              {:type "enabled" :budget_tokens thinking-budget}))
        effective-thinking (or explicit-thinking portable-thinking)
        explicit-cache? (contains-cache-control? body-options)
        effective-beta-headers
        (vec (distinct
               (concat beta-headers
                       (when (some? effective-thinking)
                         ["interleaved-thinking-2025-05-14"])
                       (when (or auto-cache? explicit-cache?)
                         ["prompt-caching-2024-07-31"]))))
        msgs (if auto-cache? (cache-anthropic-prefix raw-msgs) raw-msgs)
        anthropic-tools (if (and auto-cache? (seq raw-tools))
                          (annotate-last-cacheable raw-tools)
                          raw-tools)
        system-value (if auto-cache?
                       [{:type "text" :text system-text
                         :cache_control {:type "ephemeral"}}]
                       system-text)
        payload (merge
                  (cond-> {:model (:model request)
                           :messages msgs
                           :max_tokens max-tokens}
                    (not (str/blank? system-text)) (assoc :system system-value)
                    (seq anthropic-tools) (assoc :tools anthropic-tools)
                    (some? tool-choice) (assoc :tool_choice tool-choice)
                    (some? (:temperature request))
                    (assoc :temperature (:temperature request))
                    (some? (:top_p request))
                    (assoc :top_p (:top_p request))
                    (some? (:stop_sequences request))
                    (assoc :stop_sequences (:stop_sequences request))
                    (some? portable-thinking)
                    (assoc :thinking portable-thinking)
                    (some? (anthropic-metadata request))
                    (assoc :metadata (anthropic-metadata request)))
                  body-options)
        output-config (field payload :output_config)
        payload (if (and adaptive? effort (nil? (field output-config :effort)))
                  (assoc (dissoc payload "output_config") :output_config
                         (assoc (or output-config {}) :effort effort))
                  payload)
        _tool-choice-check
        (when (and (= false (:forced_tool_choice model-info))
                   (contains? #{"any" "tool"} (field (field payload :tool_choice) :type)))
          (throw (ex-info "This model does not support forced tool choice"
                          {:category :unsupported-tool-choice :retryable false
                           :provider (or (:provider request) "anthropic")
                           :model (:model request)})))
        final-thinking (field payload :thinking)
        final-thinking-type (field final-thinking :type)
        _thinking-mode-check
        (when (and (:adaptive_only model-info) (some? final-thinking)
                   (not= "adaptive" final-thinking-type))
          (throw (ex-info "This model requires adaptive thinking"
                          {:category :invalid-request :retryable false
                           :provider (or (:provider request) "anthropic")
                           :model (:model request)})))
        final-thinking-budget (field final-thinking :budget_tokens)
        final-max-tokens (field payload :max_tokens)
        _thinking-budget-check
        (when (and (= "enabled" final-thinking-type)
                   (number? final-thinking-budget)
                   (or (not (number? final-max-tokens))
                       (<= final-thinking-budget 0)
                       (>= final-thinking-budget final-max-tokens)))
          (throw
            (ex-info
              (str "Anthropic max_tokens must exceed the positive reasoning budget of "
                   final-thinking-budget)
              {:category :invalid-request
               :max_tokens final-max-tokens
               :reasoning_budget final-thinking-budget})))
        headers (request-headers request key :anthropic-messages
                                 (cond-> {"anthropic-version" "2023-06-01"
                                          "Content-Type" "application/json"}
                                   (seq effective-beta-headers)
                                   (assoc "anthropic-beta" (str/join "," effective-beta-headers))))]
    (require-api-key! (or (:provider request) "anthropic") key :anthropic-messages)
    {:url url :headers headers :payload payload}))

(defn- anthropic-usage [usage]
  (let [input (or (get usage "input_tokens") 0)
        output (or (get usage "output_tokens") 0)]
    {:input_tokens input
     :output_tokens output
     :cache_read_tokens (or (get usage "cache_read_input_tokens") 0)
     :cache_write_tokens (or (get usage "cache_creation_input_tokens") 0)
     :total_tokens (+ input output)}))

(defn- normalize-anthropic-part [block]
  (case (get block "type")
    "text" {:kind :text :text (or (get block "text") "")}
    "image"
    (let [source (or (get block "source") {})]
      {:kind :image
       :image (if (= (get source "type") "url")
                {:url (get source "url")
                 :media_type (get source "media_type")}
                {:data (base64-decode (or (get source "data") ""))
                 :media_type (get source "media_type")})})
    "document"
    (let [source (or (get block "source") {})]
      {:kind :document
       :document (if (= (get source "type") "url")
                   {:url (get source "url")
                    :media_type (get source "media_type")}
                   {:data (base64-decode (or (get source "data") ""))
                    :media_type (get source "media_type")})})
    "tool_use"
    {:kind :tool_call
     :tool_call {:id (or (get block "id") "")
                 :name (or (get block "name") "")
                 :arguments (or (get block "input") {})}}
    "thinking"
    {:kind :thinking
     :thinking {:text (or (get block "thinking") "")
                :signature (get block "signature")
                :redacted false}}
    "redacted_thinking"
    {:kind :redacted_thinking
     :thinking {:data (get block "data") :redacted true}}
    {:kind (keyword (or (get block "type") "provider_content"))
     :provider_data block}))

(defn- normalize-anthropic-response [request body-map]
  (let [content-blocks (or (get body-map "content") [])
        text (str/join ""
                       (map (fn [block]
                              (if (= (get block "type") "text")
                                (or (get block "text") "")
                                ""))
                            content-blocks))
        reasoning (str/join ""
                            (map (fn [block]
                                   (if (= (get block "type") "thinking")
                                     (or (get block "thinking") "")
                                     ""))
                                 content-blocks))
        tool-calls (normalize-anthropic-tool-calls content-blocks)
        base-usage (anthropic-usage (or (get body-map "usage") {}))
        usage (assoc base-usage :reasoning_tokens
                     (if (str/blank? reasoning)
                       0
                       (quot (+ (count reasoning) 3) 4)))
        parts (mapv normalize-anthropic-part content-blocks)]
    {:id (get body-map "id")
     :model (or (get body-map "model") (:model request))
     :provider "anthropic"
     :message {:role :assistant :content parts :parts parts :text text}
     :reasoning reasoning
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (get body-map "stop_reason")))
     :warnings (adapter-warnings "anthropic" request)
     :raw body-map}))

(defn anthropic-complete [request & [api-key base-url]]

(defn anthropic-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (anthropic-request-data request api-key base-url)]
    (try
        (let [transport (or (:transport request) http/request)
              resp (invoke-transport transport
                     (transport-request-options
                       request
                       {:method :post
                        :url url
                        :headers headers
                        :body (json/write-json (json-safe payload))}))
              status (:status resp)
              body-str (str (:body resp))]
          (if (and (number? status) (not= status 200))
            (raise-provider-error! "anthropic" resp)
            (normalize-anthropic-response request (parse-response-body "anthropic" body-str))))
        (catch Object e (throw e)))))

;; Gemini native generateContent adapter.
(defn- gemini-content-part [part]
  (if (some? (:provider_data part))
    (:provider_data part)
    (if (or (some? (get part "text"))
          (some? (get part "inlineData"))
          (some? (get part "fileData"))
          (some? (get part "functionCall"))
          (some? (get part "functionResponse")))
      part
      (let [kind (content-kind part)]
      (case kind
        :text {:text (or (:text part) (:content part) "")}
        (:image :audio :document)
        (let [binary (resolve-binary-content
                       part kind
                       (case kind
                         :image "image/png"
                         :audio "audio/wav"
                         "application/pdf"))]
          (if (:url binary)
            {:fileData {:mimeType (:media_type binary)
                        :fileUri (:url binary)}}
            {:inlineData {:mimeType (:media_type binary)
                          :data (:data binary)}}))
        :tool_call
        (let [call (content-data part :tool_call)]
          {:functionCall
           {:name (or (:name call) (get call "name"))
            :args (or (:arguments call) (get call "arguments") {})}})
        :thinking
        (let [thinking (content-data part :thinking)]
          {:text (or (:text thinking) (get thinking "text") "")
           :thought true})
        (unsupported-content! "gemini" kind))))))

(defn- gemini-message [message call-names]
  (let [role (:role message)
        content (:content message)
        tool-calls (:tool_calls message)]
    (cond
      (= role :tool)
      {:role "user"
       :parts (vec
                (mapcat
                  (fn [result]
                    (let [value (tool-result-data result)
                          images (tool-result-images value)
                          result-content (or (:content value)
                                             (get value "content"))
                          is-error (or (:is_error value)
                                       (get value "is_error"))]
                      (concat
                        [{:functionResponse
                          {:name (or (:tool_name value)
                                     (get value "tool_name")
                                     (when call-names
                                       (get @call-names
                                            (or (:tool_call_id value)
                                                (get value "tool_call_id"))))
                                     "")
                           :response (if is-error
                                       {:error result-content}
                                       (if (map? result-content)
                                         result-content
                                         {:result result-content}))}}]
                        (map (fn [image]
                               {:inlineData {:mimeType (:media_type image)
                                             :data (:data image)}}) images))))
                  content))}

      (= role :assistant)
      (let [source-parts (if (and (not (seq (:parts message)))
                                  (not (vector? content))
                                  (str/blank? (str content)))
                           []
                           (message-content-parts message))
            embeds-tool-calls
            (some (fn [part]
                    (or (= :tool_call (content-kind part))
                        (some? (get part "functionCall"))))
                  source-parts)]
        {:role "model"
         :parts (vec
                  (concat
                    (map gemini-content-part source-parts)
                    (when-not embeds-tool-calls
                      (map (fn [call]
                             {:functionCall {:name (:name call)
                                             :args (:arguments call)}})
                           (or tool-calls [])))))} )

      :else {:role "user"
             :parts (mapv gemini-content-part
                          (message-content-parts message))})))

(defn normalize-gemini-tool-calls [parts]
  (mapv (fn [part]
          (let [call (get part "functionCall")]
            {:id (or (get call "id") (str "call_" (ids/uuid-text)))
             :name (or (get call "name") "")
             :arguments (or (get call "args") {})}))
        (filter (fn [part] (some? (get part "functionCall"))) (or parts []))))

(defn- gemini-request-data [request api-key base-url]
  (let [key (request-api-key request api-key "GEMINI_API_KEY")
        url (resolve-gemini-url (or base-url (:base_url request)) (:model request))
        system-messages (filter (fn [m]
                                  (or (= (:role m) :system)
                                      (= (:role m) :developer)))
                                (:messages request))
        system-text (str/join "\n\n" (map message-text system-messages))
        call-names (:gemini_call_names request)
        contents (mapv (fn [message] (gemini-message message call-names))
                       (remove (fn [m]
                                 (or (= (:role m) :system)
                                     (= (:role m) :developer)))
                               (:messages request)))
        tools (or (:tools request) [])
        generation-config (gemini-generation-config request)
        tool-choice (gemini-tool-choice request)
        payload
        (merge-gemini-provider-options
          (cond-> {:contents contents}
            (not (str/blank? system-text))
            (assoc :systemInstruction {:parts [{:text system-text}]})
            (seq tools) (assoc :tools
                               [{:functionDeclarations
                                 (mapv (fn [tool]
                                         {:name (:name tool)
                                          :description (:description tool)
                                          :parameters (:parameters tool)})
                                       tools)}])
            (some? tool-choice) (assoc :toolConfig tool-choice)
            (seq generation-config) (assoc :generationConfig generation-config))
          (provider-options request "gemini"))
        headers (request-headers request key :gemini-generate-content {"Content-Type" "application/json"})]
    (require-api-key! (or (:provider request) "gemini") key :gemini-generate-content)
    {:url url :headers headers :payload payload}))

(defn- gemini-usage [usage]
  {:input_tokens (or (get usage "promptTokenCount") 0)
   :output_tokens (or (get usage "candidatesTokenCount") 0)
   :reasoning_tokens (or (get usage "thoughtsTokenCount") 0)
   :cache_read_tokens (or (get usage "cachedContentTokenCount") 0)
   :total_tokens (or (get usage "totalTokenCount") 0)})

(defn- content-kind-for-media-type [media-type]
  (let [mime (str/lower-case (str (or media-type "")))]
    (cond
      (str/starts-with? mime "image/") :image
      (str/starts-with? mime "audio/") :audio
      :else :document)))

(defn- normalize-gemini-parts [native-parts]
  (reduce
    (fn [[parts calls] part]
      (cond
        (some? (get part "functionCall"))
        (let [native (get part "functionCall")
              call {:id (or (get native "id") (str "call_" (ids/uuid-text)))
                    :name (or (get native "name") "")
                    :arguments (or (get native "args") {})}]
          [(conj parts {:kind :tool_call :tool_call call})
           (conj calls call)])

        (some? (get part "text"))
        (if (get part "thought")
          [(conj parts {:kind :thinking
                        :thinking {:text (or (get part "text") "")
                                   :redacted false}})
           calls]
          [(conj parts {:kind :text :text (or (get part "text") "")}) calls])

        (some? (get part "inlineData"))
        (let [inline (get part "inlineData")
              mime (get inline "mimeType")
              kind (content-kind-for-media-type mime)]
          [(conj parts {:kind kind
                        kind {:data (base64-decode (or (get inline "data") ""))
                              :media_type mime}})
           calls])

        (some? (get part "fileData"))
        (let [file (get part "fileData")
              mime (get file "mimeType")
              kind (content-kind-for-media-type mime)]
          [(conj parts {:kind kind
                        kind {:url (get file "fileUri") :media_type mime}})
           calls])

        :else
        [(conj parts {:kind :provider_content :provider_data part}) calls]))
    [[] []]
    (or native-parts [])))

(defn- normalize-gemini-response [request body]
  (let [candidate (first (get body "candidates"))
        parts (or (get-in candidate ["content" "parts"]) [])
        text (str/join "" (map (fn [part]
                                  (if (and (some? (get part "text"))
                                           (not (get part "thought")))
                                    (or (get part "text") "")
                                    ""))
                                parts))
        normalized (normalize-gemini-parts parts)
        content-parts (first normalized)
        tool-calls (second normalized)
        usage (gemini-usage (or (get body "usageMetadata") {}))]
    (when-let [call-names (:gemini_call_names request)]
      (doseq [call tool-calls]
        (swap! call-names assoc (:id call) (:name call))))
    {:id (get body "responseId")
     :model (or (get body "modelVersion") (:model request))
     :provider "gemini"
     :message {:role :assistant :content content-parts :parts content-parts
               :text text}
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (get candidate "finishReason")))
     :warnings (adapter-warnings "gemini" request)
     :raw body}))

(defn gemini-complete [request & [api-key base-url]]

(defn gemini-complete [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (gemini-request-data request api-key base-url)]
    (try
        (let [transport (or (:transport request) http/request)
              resp (invoke-transport transport
                     (transport-request-options
                       request
                       {:method :post :url url :headers headers
                        :body (json/write-json (json-safe payload))}))
              status (:status resp)
              body-str (str (:body resp))]
          (if (and (number? status) (not= status 200))
            (raise-provider-error! "gemini" resp)
            (normalize-gemini-response request (parse-response-body "gemini" body-str))))
        (catch Object e (throw e)))))

;; Unified Client Complete
(defn complete [request & [client-opts]]
  (let [opts (merge request client-opts)
        parsed (parse-model-spec (:model request) (or (:provider request) (:provider opts)))
        provider (:provider parsed)
        actual-model (:model parsed)
        req (assoc request :provider provider :model actual-model)]
    (case (providers/protocol-of provider)
      :openai-responses (openai-complete req (:api_key opts) (:base_url opts))
      :openai-chat-completions (openai-compatible-complete req (:api_key opts) (:base_url opts))
      :anthropic-messages (anthropic-complete req (:api_key opts) (:base_url opts))
      :gemini-generate-content (gemini-complete req (:api_key opts) (:base_url opts))
      :mock (mock-complete req (:mock_handler opts))
      (throw (ex-info (str "Unsupported LLM provider: " provider)
                      {:provider provider :category :configuration :retryable false})))))

(defn- sse-field-value [line prefix-length]
  (let [value (subs line prefix-length)]
    (if (str/starts-with? value " ") (subs value 1) value)))

(defn- sse-event [state]
  (cond-> {:event (:event state)
           :data (str/join "\n" (:data state))}
    (some? (:retry state)) (assoc :retry (:retry state))))

(defn parse-sse-lines [lines]

(defn openai-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]} (openai-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json
                          (json-safe (assoc payload :stream true)))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "openai" request resp)
      (let [state (atom {:text_started #{} :text_ended #{}
                           :reasoning_started #{} :reasoning_ended #{}
                           :tools {}})]
        (native-stream-events request (:body resp) "openai"
                              #(openai-stream-events request state %))))))

(defn- append-string [value delta]
  (str (or value "") (or delta "")))

(defn- compatible-stream-tool-delta! [state native raw]
  (let [index (or (get native "index") (count (:tool_order @state)))
        existing (get-in @state [:tools index])
        function-data (or (get native "function") {})
        arguments-present? (contains? function-data "arguments")
        argument-delta (or (get function-data "arguments") "")
        call {:id (or (get native "id") (:id existing) (str "call_" index))
              :name (or (get function-data "name") (:name existing) "")
              :arguments (append-string (:arguments existing) argument-delta)
              :arguments_present (or (:arguments_present existing)
                                     arguments-present?)}
        first-delta? (nil? existing)]
    (when first-delta?
      (swap! state update :tool_order conj index))
    (swap! state assoc-in [:tools index] call)
    {:type (if first-delta? :tool_call_start :tool_call_delta)
     :tool_call (assoc call :arguments argument-delta)
     :raw raw}))

(defn- compatible-stream-tool-call [call]
  (let [arguments (:arguments call)
        arguments-present? (:arguments_present call)]
    (cond->
      (assoc (dissoc call :arguments_present) :arguments
             (if (and (not arguments-present?) (str/blank? arguments))
               {}
               (try
                 (json/read-json arguments)
                 (catch Object _ arguments))))
      (and arguments-present? (string? arguments))
      (assoc :raw_arguments arguments))))

(defn- compatible-stream-response [request state]
  (let [snapshot @state
        text (:text snapshot)
        tool-calls (mapv
                     (fn [index]
                       (compatible-stream-tool-call
                         (get-in snapshot [:tools index])))
                     (:tool_order snapshot))
        parts (vec
                (concat
                  (when (not= "" text) [{:kind :text :text text}])
                  (map (fn [call] {:kind :tool_call :tool_call call})
                       tool-calls)))
        native-reason (:finish_reason snapshot)
        reason (if (some? native-reason)
                 (finish-reason native-reason)
                 (if (seq tool-calls) :tool_calls :other))]
    {:id (:id snapshot)
     :model (or (:model snapshot) (:model request))
     :provider (or (:provider request) "openai-compatible")
     :message {:role :assistant :content parts :parts parts :text text}
     :tool_calls tool-calls
     :reasoning (:reasoning snapshot)
     :usage (openai-compatible-usage (:usage snapshot))
     :finish_reason reason
     :warnings (adapter-warnings "openai-compatible" request)
     :raw (:raw snapshot)}))

(defn- compatible-stream-finish-events [request state]
  (let [snapshot @state
        response (compatible-stream-response request state)
        raw (:raw snapshot)]
    (vec
      (concat
        (when (:text_started snapshot)
          [{:type :text_end :text_id "text" :text (or (:text snapshot) "") :raw raw}])
        (when (:reasoning_started snapshot)
          [{:type :reasoning_end :text_id "reasoning"
            :reasoning (:reasoning snapshot) :raw raw}])
        (map (fn [index]
               {:type :tool_call_end
                :tool_call (compatible-stream-tool-call
                             (get-in snapshot [:tools index]))
                :raw raw})
             (:tool_order snapshot))
        [{:type :finish
          :finish_reason (:finish_reason response)
          :usage (:usage response)
          :response response
          :raw raw}]))))

(defn- compatible-stream-events [request state event]
  (let [data (str/trim (:data event))]
    (if (:failed @state)
      []
      (if (= data "[DONE]")
        (compatible-stream-finish-events request state)
        (let [body (json/read-json data)
            error (get body "error")
            first-event? (not (:started @state))]
        (if (some? error)
          (do
            (swap! state assoc :started true :failed true :raw body)
            (vec
              (concat
                (when first-event?
                  [{:type :stream_start
                    :warnings (adapter-warnings "openai-compatible" request)
                    :raw body}])
                [{:type :error :error error :raw body}])))
          (let [choice (first (or (get body "choices") []))
                delta (or (get choice "delta") {})
                content (get delta "content")
                reasoning (get delta "reasoning_content")
                first-reasoning? (and (string? reasoning)
                                      (not (:reasoning_started @state)))
                native-tools (or (get delta "tool_calls") [])
                first-text? (and (some? content)
                                 (not (:text_started @state)))]
            (swap! state assoc :started true :raw body)
            (when-let [id (get body "id")] (swap! state assoc :id id))
            (when-let [model (get body "model")] (swap! state assoc :model model))
            (when-let [usage (get body "usage")]
              (swap! state update :usage merge usage))
            (when-let [reason (get choice "finish_reason")]
              (swap! state assoc :finish_reason reason))
            (when first-reasoning? (swap! state assoc :reasoning_started true))
            (when (string? reasoning)
              (swap! state update :reasoning append-string reasoning))
            (when first-text? (swap! state assoc :text_started true))
            (when (some? content)
              (swap! state update :text append-string content))
            (vec
              (concat
                (when first-event?
                  [{:type :stream_start
                    :warnings (adapter-warnings "openai-compatible" request)
                    :raw body}])
                (when first-reasoning?
                  [{:type :reasoning_start :text_id "reasoning" :raw body}])
                (when (string? reasoning)
                  [{:type :reasoning_delta :reasoning_delta reasoning
                    :text_id "reasoning" :raw body}])
                (when first-text?
                  [{:type :text_start :text_id "text" :raw body}])
                (when (some? content)
                  [{:type :text_delta :delta content
                    :text_id "text" :raw body}])
                (map (fn [native]
                       (compatible-stream-tool-delta! state native body))
                     native-tools))))))))))

(defn openai-compatible-stream [request & [api-key base-url]]

(defn openai-compatible-stream [request & [api-key base-url]]
  (let [{:keys [provider url headers payload]}
        (openai-compatible-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        stream-payload (assoc payload
                              :stream true
                              :stream_options
                              (merge {:include_usage true}
                                     (canonical-option-map
                                       (:stream_options payload))))
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json (json-safe stream-payload))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! provider request resp)
      (let [state (atom {:started false :text_started false :text ""
                           :tools {} :tool_order [] :usage {}})]
        (native-stream-events request (:body resp) provider
                              #(compatible-stream-events request state %))))))

(defn- anthropic-stream-event [request state event]
  ;; Some Messages-compatible gateways (OpenRouter) append a Chat Completions
  ;; style "[DONE]" sentinel after message_stop; it carries no event.
  (when-not (= "[DONE]" (str/trim (str (:data event))))
   (let [body (json/read-json (:data event))
         event-type (or (get body "type") (:event event))]
    (case event-type
      "message_start"
      (let [message (or (get body "message") {})]
        (swap! state assoc
               :id (get message "id")
               :model (or (get message "model") (:model request))
               :usage (or (get message "usage") {}))
        {:type :stream_start :raw body})

      "content_block_start"
      (let [index (or (get body "index") 0)
            block (or (get body "content_block") {})
            block-type (get block "type")]
        (swap! state assoc-in [:blocks index] block)
        (swap! state update :order conj index)
        (case block-type
          "text" {:type :text_start :text_id (str "text-" index) :raw body}
          "tool_use" {:type :tool_call_start
                      :tool_call {:id (or (get block "id") "")
                                  :name (or (get block "name") "")
                                  :arguments (or (get block "input") {})}
                      :raw body}
          ("thinking" "redacted_thinking")
          {:type :reasoning_start :text_id (str "reasoning-" index) :raw body}
          {:type :provider_event :raw body}))

      "content_block_delta"
      (let [index (or (get body "index") 0)
            delta (or (get body "delta") {})
            delta-type (get delta "type")]
        (case delta-type
          "text_delta"
          (let [text (or (get delta "text") "")]
            (swap! state update-in [:blocks index "text"] append-string text)
            {:type :text_delta :delta text :text_id (str "text-" index) :raw body})

          "input_json_delta"
          (let [partial (or (get delta "partial_json") "")
                block (get-in @state [:blocks index])]
            (swap! state update-in [:blocks index :partial_json] append-string partial)
            {:type :tool_call_delta
             :tool_call {:id (or (get block "id") "")
                         :name (or (get block "name") "")
                         :arguments partial}
             :raw body})

          "thinking_delta"
          (let [thinking (or (get delta "thinking") "")]
            (swap! state update-in [:blocks index "thinking"] append-string thinking)
            {:type :reasoning_delta :reasoning_delta thinking
             :text_id (str "reasoning-" index) :raw body})

          "signature_delta"
          (do
            (swap! state update-in [:blocks index "signature"]
                   append-string (or (get delta "signature") ""))
            nil)

          {:type :provider_event :raw body}))

      "content_block_stop"
      (let [index (or (get body "index") 0)
            block (or (get-in @state [:blocks index]) {})
            block-type (get block "type")]
        (case block-type
          "text" {:type :text_end :text_id (str "text-" index) :text (or (get block "text") "") :raw body}
          "tool_use"
          (let [raw-args (or (:partial_json block) "")
                args (if (str/blank? raw-args)
                       (or (get block "input") {})
                       (try (json/read-json raw-args)
                            (catch Object _ {})))
                tool-call {:id (or (get block "id") "")
                           :name (or (get block "name") "")
                           :arguments args}]
            (swap! state assoc-in [:blocks index "input"] args)
            {:type :tool_call_end :tool_call tool-call :raw body})
          ("thinking" "redacted_thinking")
          {:type :reasoning_end :text_id (str "reasoning-" index)
           :reasoning (if (= block-type "thinking") (or (get block "thinking") "") "") :raw body}
          {:type :provider_event :raw body}))

      "message_delta"
      (let [delta (or (get body "delta") {})]
        (swap! state update :usage merge (or (get body "usage") {}))
        (swap! state assoc :stop_reason (get delta "stop_reason"))
        nil)

      "message_stop"
      (let [snapshot @state
            blocks (mapv (fn [index] (get-in snapshot [:blocks index]))
                         (:order snapshot))
            response (normalize-anthropic-response
                       request
                       {"id" (:id snapshot)
                        "model" (:model snapshot)
                        "content" blocks
                        "usage" (:usage snapshot)
                        "stop_reason" (:stop_reason snapshot)})]
        {:type :finish
         :finish_reason (:finish_reason response)
         :usage (:usage response)
         :response response
         :raw body})

      "error" {:type :error :error (or (get body "error") body) :raw body}
      {:type :provider_event :raw body})))
)
(defn anthropic-stream [request & [api-key base-url]]

(defn anthropic-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (anthropic-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url url :headers headers :as :stream
                  :body (json/write-json
                          (json-safe (assoc payload :stream true)))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "anthropic" request resp)
      (let [state (atom {:blocks {} :order [] :usage {}})]
        (native-stream-events request (:body resp) "anthropic"
                              #(when-let [event (anthropic-stream-event request state %)]
                                 (list event)))))))

(defn- gemini-stream-url [url]
  (str/replace url ":generateContent" ":streamGenerateContent?alt=sse"))

(defn- gemini-stream-response [request state raw]
  (let [snapshot @state
        tool-calls (:tool_calls snapshot)
        usage (gemini-usage (:usage snapshot))
        parts (vec
                (concat
                  (when-not (str/blank? (:reasoning snapshot))
                    [{:kind :thinking
                      :thinking {:text (:reasoning snapshot)
                                 :redacted false}}])
                  (when-not (str/blank? (:text snapshot))
                    [{:kind :text :text (:text snapshot)}])
                  (map (fn [call] {:kind :tool_call :tool_call call})
                       tool-calls)))]
    {:id (:id snapshot)
     :model (or (:model snapshot) (:model request))
     :provider "gemini"
     :message {:role :assistant :content parts :parts parts
               :text (:text snapshot)}
     :tool_calls tool-calls
     :usage usage
     :finish_reason (if (seq tool-calls)
                      :tool_calls
                      (finish-reason (:finish_reason snapshot)))
     :warnings (adapter-warnings "gemini" request)
     :raw raw}))

(defn- gemini-stream-events [request state event]
  (let [body (if (= "[DONE]" (str/trim (str (:data event)))) {} (json/read-json (:data event)))]
    (if-let [error (get body "error")]
      [{:type :error :error error :raw body}]
      (let [candidate (first (or (get body "candidates") []))
        parts (or (get-in candidate ["content" "parts"]) [])
        text-parts (filter (fn [part]
                             (and (some? (get part "text"))
                                  (not (get part "thought"))))
                           parts)
        reasoning-parts (filter (fn [part]
                                  (and (some? (get part "text"))
                                       (get part "thought")))
                                parts)
        provider-calls (filter (fn [part] (some? (get part "functionCall"))) parts)
        calls (mapv (fn [part]
                      (let [call (get part "functionCall")]
                        {:id (or (get call "id") (str "call_" (ids/uuid-text)))
                         :name (or (get call "name") "")
                         :arguments (or (get call "args") {})}))
                    provider-calls)
        first-event? (not (:started @state))
        first-text? (and (seq text-parts) (not (:text_started @state)))
        first-reasoning? (and (seq reasoning-parts) (not (:reasoning_started @state)))
        finish-provider (get candidate "finishReason")]
    (swap! state assoc :started true)
    (when-let [id (get body "responseId")] (swap! state assoc :id id))
    (when-let [model (get body "modelVersion")] (swap! state assoc :model model))
    (when-let [usage (get body "usageMetadata")] (swap! state update :usage merge usage))
    (when first-text? (swap! state assoc :text_started true))
    (when first-reasoning? (swap! state assoc :reasoning_started true))
    (doseq [part text-parts]
      (swap! state update :text append-string (get part "text")))
    (doseq [part reasoning-parts]
      (swap! state update :reasoning append-string (get part "text")))
    (when (seq calls) (swap! state update :tool_calls into calls))
    (when-let [call-names (:gemini_call_names request)]
      (doseq [call calls]
        (swap! call-names assoc (:id call) (:name call))))
    (when finish-provider (swap! state assoc :finish_reason finish-provider))
    (let [start-events (when first-event? [{:type :stream_start :raw body}])
          text-events (concat
                        (when first-text? [{:type :text_start :text_id "text" :raw body}])
                        (map (fn [part]
                               {:type :text_delta :delta (or (get part "text") "")
                                :text_id "text" :raw body})
                             text-parts))
          reasoning-events (concat
                             (when first-reasoning?
                               [{:type :reasoning_start :text_id "reasoning" :raw body}])
                             (map (fn [part]
                                    {:type :reasoning_delta
                                     :reasoning_delta (or (get part "text") "")
                                     :text_id "reasoning" :raw body})
                                  reasoning-parts))
          tool-events (mapcat (fn [call]
                                [{:type :tool_call_start :tool_call call :raw body}
                                 {:type :tool_call_end :tool_call call :raw body}])
                              calls)
          end-events (when finish-provider
                       (concat
                         (when (:text_started @state)
                           [{:type :text_end :text_id "text" :text (or (:text @state) "") :raw body}])
                         (when (:reasoning_started @state)
                           [{:type :reasoning_end :text_id "reasoning" :reasoning (or (:reasoning @state) "") :raw body}])
                         (let [response (gemini-stream-response request state body)]
                           [{:type :finish
                             :finish_reason (:finish_reason response)
                             :usage (:usage response)
                             :response response
                             :raw body}]))) ]
      (vec (concat start-events text-events reasoning-events tool-events end-events)))))))

(defn gemini-stream [request & [api-key base-url]]

(defn gemini-stream [request & [api-key base-url]]
  (let [{:keys [url headers payload]}
        (gemini-request-data request api-key base-url)
        transport (or (:transport request) http/request)
        resp (invoke-transport transport
               (transport-request-options
                 request
                 {:method :post :url (gemini-stream-url url)
                  :headers headers :as :stream
                  :body (json/write-json (json-safe payload))}))
        status (:status resp)]
    (if (and (number? status) (not= status 200))
      (raise-stream-provider-error! "gemini" request resp)
      (let [state (atom {:started false :text_started false
                           :reasoning_started false :text "" :reasoning ""
                           :tool_calls [] :usage {}})]
        (native-stream-events request (:body resp) "gemini"
                              #(gemini-stream-events request state %))))))

(defn- provider-stream [request & [client-opts]]
  (let [opts (merge request client-opts)
        parsed (parse-model-spec (:model request) (or (:provider request) (:provider opts)))
        provider (:provider parsed)
        req (assoc request :provider provider :model (:model parsed))]
    (case (providers/protocol-of provider)
      :openai-responses (openai-stream req (:api_key opts) (:base_url opts))
      :openai-chat-completions (openai-compatible-stream req (:api_key opts) (:base_url opts))
      :anthropic-messages (anthropic-stream req (:api_key opts) (:base_url opts))
      :gemini-generate-content (gemini-stream req (:api_key opts) (:base_url opts))
      (throw (ex-info (str "Streaming is not implemented for provider: " provider)
                      {:provider provider :category :configuration :retryable false})))))

(defn make-stream-accumulator []

(defn parse-sse-lines [lines]
  (letfn [(step [remaining state]
            (lazy-seq
              (if-let [input (seq remaining)]
                (let [line (first input)
                      more (rest input)]
                  (cond
                    (str/blank? line)
                    (let [next-state {:event "" :data [] :retry (:retry state)}]
                      (if (seq (:data state))
                        (cons (sse-event state) (step more next-state))
                        (step more next-state)))

                    (str/starts-with? line ":")
                    (step more state)

                    (str/starts-with? line "event:")
                    (step more (assoc state :event
                                      (str/trim (sse-field-value line 6))))

                    (str/starts-with? line "data:")
                    (step more (update state :data conj
                                       (sse-field-value line 5)))

                    (str/starts-with? line "retry:")
                    (let [retry-value (try
                                        (parse-long
                                          (str/trim (sse-field-value line 6)))
                                        (catch Object _ nil))]
                      (step more (if (some? retry-value)
                                   (assoc state :retry retry-value)
                                   state)))

                    :else (step more state)))
                (when (seq (:data state))
                  (list (sse-event state))))))]
    (step lines {:event "" :data [] :retry nil})))

(defn- stream-lines [body]
  (if (string? body)
    (str/split body #"\r?\n")
    (io/line-seq body)))

(defn- register-provider-stream-close! [request body]
  (let [closed (atom false)
        close! (fn []
                 (when-not (first (swap-vals! closed (fn [_] true)))
                   (when (and (some? body) (not (string? body)))
                     (try (io/close body) (catch Object _ nil)))))]
    (when (fn? (:register_stream_close request))
      ((:register_stream_close request) close!))
    close!))

(defn- stream-error [provider error raw]
  (if (:category (ex-data error))
    error
    (let [payload (or (get-in raw ["response" "error"])
                      (get raw "error") error)
          code (or (get payload "code") (get payload "type"))
          ;; Gemini's native error.code is the HTTP status. Other providers'
          ;; numeric codes are not assumed to be HTTP statuses.
          status (when (and (= provider "gemini") (number? code)
                            (<= 400 code 599)) code)
          normalized (provider-error provider {:status status :body payload})
          data (ex-data normalized)
          category (if (= :provider (:category data))
                     (case code
                       ("server_error" "api_error" "overloaded_error") :server
                       ("rate_limit_exceeded" "rate_limit_error") :rate-limit
                       ("invalid_api_key" "authentication_error") :authentication
                       "permission_error" :access-denied
                       "not_found_error" :not-found
                       "invalid_request_error" :invalid-request
                       "insufficient_quota" :quota-exceeded
                       "context_length_exceeded" :context-length
                       "content_filter" :content-filter
                       :provider)
                     (:category data))]
      (ex-info (str provider " stream error: " (or (get payload "message") payload))
               (assoc data :category category
                           :retryable (not (contains? non-retryable-error-categories category))
                           :error_code (when (some? code) (str code))
                           :raw (or raw payload))))))

(defn- stream-ended-early-error [provider]
  (ex-info
    (str provider " stream ended without a finish event")
    {:category :provider
     :provider provider
     :retryable false
     :malformed_body true}))

(defn- terminal-stream-events
  "Normalize the tail of a provider stream: the first :error is normalized and
   closes the body; a stream that ends with no :finish (or :error) is a
   malformed body, so exactly one synthesized :error terminates it."
  ([events provider close!]
   (terminal-stream-events events provider close! false))
  ([events provider close! finished?]
   (terminal-stream-events events provider close! finished? false))
  ([events provider close! finished? delivered?]
   (lazy-seq
     (if-let [remaining (if delivered?
                          (try (seq events)
                               (catch Object e
                                 ;; A failure while reading later frames (stream-read
                                 ;; timeout, reset) is the stream's terminal error.
                                 ;; Before any event is delivered the failure
                                 ;; propagates so the opener can retry.
                                 (close!)
                                 (list {:type :error :error (transport-failure e) :raw nil :read_failure true})))
                          ;; Before delivery the failure still throws, typed, so
                          ;; the opener's retry policy can decide.
                          (try (seq events)
                               (catch Object e (throw (transport-failure e)))))]
       (let [event (first remaining)]
         (if (= :error (:type event))
           (do
             (close!)
             (list (assoc event :error (stream-error provider (:error event) (:raw event)))))
           (cons event (lazy-seq
                         (terminal-stream-events (rest remaining) provider close!
                                                 (or finished? (= :finish (:type event)))
                                                 true)))))
       (when-not finished?
         (close!)
         (list {:type :error :error (stream-ended-early-error provider) :raw nil}))))))

(defn- native-stream-events [request body provider normalize]
  ;; Register ownership before line-seq can read. Defer the next native frame
  ;; until every event from this frame has been consumed; error never reads it.
  (let [close! (register-provider-stream-close! request body)]
    (letfn [(step [frames]
              (lazy-seq
                (when-let [remaining (seq frames)]
                  (concat (normalize (first remaining))
                          (lazy-seq (step (rest remaining)))))))]
      (terminal-stream-events
        (step (parse-sse-lines (stream-lines body))) provider close!))))

(defn- raise-stream-provider-error! [provider request response]
  (let [body (:body response)]
    (if (or (nil? body) (string? body) (map? body))
      (raise-provider-error! provider response)
      (let [closed (atom false)
            close! (fn []
                     (when-not (first (swap-vals! closed (fn [_] true)))
                       (try (io/close body) (catch Object _ nil))))]
        (try
          ;; Publish ownership before a potentially blocking read. A cancelled
          ;; operation may invoke this immediately, or concurrently with finally.
          (when (fn? (:register_stream_close request))
            ((:register_stream_close request) close!))
          (let [text (try (io/slurp body) (catch Object _ nil))]
            ;; A broken body must not erase HTTP status/retry classification.
            (raise-provider-error! provider (assoc response :body text)))
          (finally (close!)))))))

(defn- mark-stream-part! [state key id]
  (let [seen? (contains? (get @state key #{}) id)]
    (when-not seen? (swap! state update key conj id))
    (not seen?)))

(defn- openai-segment-id [body kind]
  (let [item (or (get body "item_id") (name kind))
        index (or (get body "content_index") 0)]
    ;; Length-prefix indexed identities so provider item IDs cannot collide.
    (if (and (= index 0) (not (str/starts-with? item "segment:")))
      item (str "segment:" (count item) ":" item ":" index))))

(defn- openai-segment-events [state body kind action value]
  (let [id (openai-segment-id body kind)
        started (if (= kind :text) :text_started :reasoning_started)
        ended (if (= kind :text) :text_ended :reasoning_ended)
        start-type (if (= kind :text) :text_start :reasoning_start)
        end-type (if (= kind :text) :text_end :reasoning_end)
        delta-type (if (= kind :text) :text_delta :reasoning_delta)
        delta-key (if (= kind :text) :delta :reasoning_delta)
        start? (mark-stream-part! state started id)]
    (when start?
      (swap! state update :segment_order (fnil conj [])
             {:kind kind :item_id (get body "item_id") :content_index (or (get body "content_index") 0)})
      (when (and (= action :start) (string? value))
        (swap! state assoc-in [:segments kind id] value)))
    (vec
      (concat
        (when start? [{:type start-type :text_id id :raw body}])
        (case action
          :start []
          :delta (do
                   (swap! state update-in [:segments kind id] #(str (or % "") (or value "")))
                   [(assoc {:type delta-type :text_id id :raw body} delta-key (or value ""))])
          :end (when (mark-stream-part! state ended id)