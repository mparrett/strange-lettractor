(ns attractor.robinhood-test
  (:require [clojure.test :refer [deftest is testing]]
            [attractor.robinhood :as rh]))

;; Robinhood screener integration tests
;;
;; Note: screen-calls is the main public API. Unit tests for internal
;; filter/score functions would require making them public. For now,
;; we focus on integration testing the screener output format.

(deftest screener-outputs-formatted-results
  "Verify that screen-calls produces well-formed result maps."
  ;; This is a structure test - full integration requires a live
  ;; MCP session, which is tested in live/ tests
  (is (fn? rh/screen-calls)))

