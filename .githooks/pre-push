#!/bin/bash
# A red suite must not reach the remote: failures that land get ignored,
# and then nobody can tell a new break from an old one.
# Enable once per clone with `make hooks`. Bypass knowingly: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: make test (lgx suite, about two and a half minutes)"
exec make test
